# ---- Database (Prisma) ---------------------------------------------------
# LOCAL DEV (matches docker-compose.yml):
DATABASE_URL="postgresql://mzr:mzr@localhost:5432/mzr_parts"
DIRECT_URL="postgresql://mzr:mzr@localhost:5432/mzr_parts"

# PRODUCTION (Supabase). The pooled URL (port 6543, pgbouncer=true) is used
# by the running app; the direct URL (port 5432) is used by `prisma migrate`.
# DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ---- NextAuth ------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Image storage --------------------------------------------------------
# LOCAL DEV: leave Cloudinary + Supabase Storage blank → uploads go to
# public/uploads/.
#
# PRODUCTION: set the Supabase Storage env vars below → uploads go to
# Supabase Storage (compressed to ≤ 200 KB by sharp before upload).
# Cloudinary creds remain supported as a legacy fallback.
#
# IMPORTANT: SUPABASE_URL is the **API URL** (https://<project>.supabase.co),
# NOT the Postgres connection string. Find it under
# Project Settings → API → Project URL.
SUPABASE_URL=""
# Service role key (Project Settings → API → Service role). Server-only —
# never expose to the client. This bypasses RLS for the storage upload.
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket name. Create it in Supabase Storage and mark it public so
# getPublicUrl() returns a usable CDN URL.
SUPABASE_BUCKET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
